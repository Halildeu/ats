<?xml version="1.0" encoding="UTF-8"?>
<!--
  app-boot — ATS-0008 D-A deployable composition katmanı (ATS-0018 §2 istisnası:
  javax.sql.DataSource YALNIZ com.ats.persistence.. ve bu wiring paketinde görünür).

  Spring Boot YALNIZ bu modüldedir: domain modülleri framework-free kalır
  (component-scan com.ats.app ile sınırlı; domain bean'leri açık @Bean wiring).
  JPA/Hibernate/Spring-Data KULLANILMAZ (ATS-0018 kalıcı yasak) — starter-jdbc
  bile alınmaz; DataSource = HikariCP doğrudan, migration = Flyway programatik.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ats</groupId>
    <artifactId>ats-core-parent</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>app-boot</artifactId>
  <name>ats :: app-boot (composition)</name>

  <properties>
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- #255: Spring Boot 3.5.16 manages Tomcat 10.1.55, which Trivy blocks for
         CVE-2026-65182, CVE-2026-65905 and CVE-2026-68525. Keep the Boot line
         stable while overriding its coordinated Tomcat modules to the fixed release. -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot parent kullanılmadığı için yalnız tomcat.version tanımlamak imported
           BOM içindeki çözülmüş sürümü değiştirmez. Üç embed modülünü aynı property ile
           açıkça yöneterek güvenlik yükseltmesini atomik tutuyoruz. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- domain modülleri (framework-free) -->
    <dependency><groupId>com.ats</groupId><artifactId>ops-events</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>consent</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>ingest-media</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>ai-orchestration</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>human-review</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>application-intake</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>interview-workspace</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>offer-workspace</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>export-connector</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>retention-dsr</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>ai-provider-faz24</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>model-governance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>compliance-screening</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.ats</groupId><artifactId>persistence-postgres</artifactId><version>${project.version}</version></dependency>

    <!-- composition runtime -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- authn/z kapısı (slice-10): OAuth2 resource-server (JWT+JWKS); Spring-Data DEĞİL -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <!-- OpenAPI metadata yuzeyi (slice-15): YALNIZ JSON api-docs; swagger-UI bilincle YOK -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>2.8.6</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- Sürüm parent'taki tek kaynaktan; elle sabit sürüm yazılmaz (bkz. parent). -->
      <version>${postgresql.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Candidate CV import adapter: parser is isolated behind ResumeDocumentParser;
         JavaScript/eval/external OCR/LLM or network egress is not used. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.5</version>
    </dependency>

    <!-- test: gerçek-PG boot smoke -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Spring MVC 6 parametre-adı çözümü: -parameters (açık @PathVariable/@RequestParam
           adları da verildi; bayrak gelecekteki controller'lar için savunma-derinliği) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
